{
  "name": "vybor-master-plan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "db:setup": "node scripts/init-db.mjs && prisma db push && node --import tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx tests/e2e.ts",
    "test:data-e2e": "node --import tsx tests/data-e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "next": "^16.0.0",
    "openai": "^7.65.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "effect": "^3.22.1",
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
