generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "sqlite"
 url = "file:./dev.db"
}
model User {
 id String @id
 name String
 role String
 sessions Session[]
}
model Session {
 id String @id
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 expiresAt DateTime
}
model Project {
 id String @id @default(cuid())
 name String
 data String
 revision Int @default(1)
 status String @default("draft")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 runs Run[]
 events AuditEvent[]
}
model Run {
 id String @id @default(cuid())
 projectId String
 project Project @relation(fields: [projectId], references: [id])
 revision Int
 authorId String
 result String
 createdAt DateTime @default(now())
 review Review?
}
model Review {
 id String @id @default(cuid())
 runId String @unique
 run Run @relation(fields: [runId], references: [id])
 reviewerId String
 decision String
 comment String
 createdAt DateTime @default(now())
}
model AuditEvent {
 id String @id @default(cuid())
 projectId String
 project Project @relation(fields: [projectId], references: [id])
 actorId String
 action String
 createdAt DateTime @default(now())
}
